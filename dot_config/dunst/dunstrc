[global]
    monitor = 0
    follow = mouse
    width = 420
    height = (0, 300)
    origin = top-center
    offset = (0, 44)
    scale = 0
    notification_limit = 5
    progress_bar = true
    progress_bar_height = 10
    progress_bar_frame_width = 1
    progress_bar_min_width = 150
    progress_bar_max_width = 300

    indicate_hidden = yes
    transparency = 0
    separator_height = 2
    padding = 12
    horizontal_padding = 12
    text_icon_padding = 0

    frame_width = 2
    frame_color = "#BD93F9"
    gap_size = 4
    separator_color = frame
    sort = yes
    idle_threshold = 120

    font = JetBrainsMono Nerd Font 14
    line_height = 0
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes
    icon_position = left
    min_icon_size = 48
    max_icon_size = 72
    corner_radius = 10

    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#282A2E"
    foreground = "#C5C8C6"
    frame_color = "#6272A4"
    timeout = 5

[urgency_normal]
    background = "#282A2E"
    foreground = "#C5C8C6"
    frame_color = "#BD93F9"
    timeout = 5

[urgency_critical]
    background = "#282A2E"
    foreground = "#FF5555"
    frame_color = "#FF5555"
    timeout = 0
